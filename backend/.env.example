# Copy to backend/.env ONLY if you need to override something.
#
# By default the API already reads infra/.env, so it uses the same Postgres
# credentials Docker was started with — no extra setup needed locally.

NODE_ENV=development
PORT=4000

# Optional: set explicitly to point at another database (e.g. Neon in production).
# If unset, the URL is built from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# (read from infra/.env) against 127.0.0.1:5432.
# DATABASE_URL=postgres://user:password@host:5432/dacantour

# Where the site is allowed to call the API from (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Email notifications (Resend). Leave RESEND_API_KEY empty to log emails instead.
RESEND_API_KEY=
TEAM_INBOX=hello@dacantour.com
MAIL_FROM=Dacan Tour <no-reply@dacantour.com>
