# Copy to frontend/.env.local for local dev.

# Where content and the API live
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical site URL — used for metadata, sitemap.xml and JSON-LD.
# Must be the real production URL when you deploy (robots.txt only allows
# indexing when this matches the production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional privacy-friendly analytics (no cookie banner needed).
# Leave empty to disable — nothing is loaded unless this is set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
