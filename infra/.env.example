# Copy to infra/.env and fill in. NEVER commit the real .env.

# --- Postgres ---
POSTGRES_USER=dacan
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=dacantour

# --- Directus (CMS) ---
# Generate KEY/SECRET with: openssl rand -hex 32
DIRECTUS_KEY=replace-with-random-hex
DIRECTUS_SECRET=replace-with-random-hex
DIRECTUS_ADMIN_EMAIL=admin@dacantour.com
DIRECTUS_ADMIN_PASSWORD=change-me

# --- URLs wired into the frontend ---
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000

# --- Backend (Phase 2) ---
# DATABASE_URL is only needed for a remote DB (e.g. Neon in production). Locally the
# API builds the connection from POSTGRES_USER/PASSWORD/DB above, so there's no second
# copy of the password to drift out of sync.
# DATABASE_URL=postgres://user:password@host:5432/dacantour
RESEND_API_KEY=
TEAM_INBOX=hello@dacantour.com
