{
  "name": "dacantour",
  "version": "0.1.0",
  "private": true,
  "description": "Dacan Tour — Kyrgyzstan & US trips website (monorepo)",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run start:dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "compose:up": "docker compose -f infra/docker-compose.yml up --build",
    "compose:down": "docker compose -f infra/docker-compose.yml down",
    "cms:bootstrap": "node cms/bootstrap.mjs",
    "cms:reset": "node cms/bootstrap.mjs --reset",
    "cms:seed": "node cms/bootstrap.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "//overrides": "Pin ONE React across the workspace. Test libs accept React 18 or 19 as a peer, and npm will happily hoist 19 next to the app's 18 — which breaks rendering with 'A React Element from an older version of React was rendered'.",
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
